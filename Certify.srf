# ==========================================================
# Make.universal Certification Specification v1
# File: Certify.srf
# ==========================================================

certification {
    name        = "make.universal"
    version     = "1.0.0"
    standard    = "make.universal"
    status      = "required"
}

project {
    manifest = "build.mu"

    require {
        name        = true
        version     = true
        description = true
        license     = true
    }
}

# ----------------------------------------------------------
# Source validation
# ----------------------------------------------------------

source {
    required = true

    validate {
        syntax      = true
        headers     = true
        dependencies = true
        duplicate_files = true
    }

    languages = [
        "c",
        "cpp",
        "rust",
        "go",
        "python",
        "node",
        "swift"
    ]
}

# ----------------------------------------------------------
# Build validation
# ----------------------------------------------------------

build {
    required = true

    validate {
        compiler      = true
        standard      = true
        warnings      = true
        optimization  = true
        reproducible  = true
    }

    clean_build = true
}

# ----------------------------------------------------------
# Testing
# ----------------------------------------------------------

testing {
    required = true

    framework = "ctest"

    checks {
        unit       = true
        integration = true
        regression = true
    }

    coverage {
        enabled = true
        minimum = 80
    }

    fail_on_test_failure = true
}

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------

security {
    required = true

    scan {
        cve     = true
        osv     = true
        secrets = true
        licenses = true
    }

    sbom {
        required = true
        format   = "spdx"
    }

    sarif {
        required = true
    }

    fail_on = "critical"
}

# ----------------------------------------------------------
# Artifact validation
# ----------------------------------------------------------

artifacts {
    required = true

    validate {
        binary         = true
        static_library = true
        shared_library = true
    }

    checksums = [
        "sha256",
        "sha512"
    ]
}

# ----------------------------------------------------------
# Platform certification
# ----------------------------------------------------------

platform "macos" {
    required = true

    architectures = [
        "arm64",
        "x86_64"
    ]

    universal = true
}

platform "linux" {
    required = true

    architectures = [
        "x86_64",
        "aarch64"
    ]
}

platform "windows" {
    required = true

    architectures = [
        "x64",
        "arm64"
    ]
}

# ----------------------------------------------------------
# Reproducibility
# ----------------------------------------------------------

reproducibility {
    required = true

    builds = 2

    compare {
        binary     = true
        artifacts  = true
        checksums  = true
    }
}

# ----------------------------------------------------------
# Supply-chain certification
# ----------------------------------------------------------

supply_chain {
    sbom        = true
    provenance  = true
    dependencies = true

    verify {
        sources = true
        packages = true
        artifacts = true
    }
}

# ----------------------------------------------------------
# Release certification
# ----------------------------------------------------------

release {
    signing = true
    provenance = true

    checksums = [
        "sha256",
        "sha512"
    ]

    verify_signature = true
    verify_checksum  = true
}

# ----------------------------------------------------------
# Certification policy
# ----------------------------------------------------------

policy {
    fail_on = [
        "build_failure",
        "test_failure",
        "critical_cve",
        "secret_detected",
        "license_violation",
        "invalid_signature",
        "invalid_checksum",
        "missing_sbom",
        "missing_provenance"
    ]
}

# ----------------------------------------------------------
# Certification output
# ----------------------------------------------------------

report {
    directory = "build/certification"

    formats = [
        "srf",
        "json",
        "sarif"
    ]

    include {
        project       = true
        build         = true
        tests         = true
        security      = true
        artifacts     = true
        platforms     = true
        provenance    = true
        checksums     = true
    }
}

# ----------------------------------------------------------
# Final certification
# ----------------------------------------------------------

certify {
    command = "make certify"

    result {
        pass = "CERTIFIED"
        fail = "NOT_CERTIFIED"
    }
}
```
