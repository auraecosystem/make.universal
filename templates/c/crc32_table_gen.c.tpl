#include <inttypes.h> #include <stdint.h> #include <stdio.h> #define CRC32_POLY UINT32_C(0xEDB88320) static uint32_t crc32_table_entry(uint32_t index) { uint32_t crc = index; for (unsigned bit = 0; bit < 8; ++bit) { if (crc & UINT32_C(1)) { crc = (crc >> 1) ^ CRC32_POLY; } else { crc >>= 1; } } return crc; } int main(void) { FILE *out = fopen("crc32_table.h", "w"); if (out == NULL) { perror("crc32_table.h"); return 1; } fprintf(out, "#ifndef CRC32_TABLE_H\n" "#define CRC32_TABLE_H\n\n" "#include <stdint.h>\n\n" "static const uint32_t crc32_table[256] = {\n" ); for (unsigned i = 0; i < 256; ++i) { fprintf( out, " UINT32_C(0x%08" PRIX32 ")%s", crc32_table_entry(i), i == 255 ? "" : "," ); if ((i + 1) % 4 == 0) fputc('\n', out); else fputc(' ', out); } fprintf(out, "};\n\n" "#endif\n" ); fclose(out); return 0; }
