#include <stddef.h> #include <stdint.h> #include "crc32.h" #include "crc32_table.h" uint32_t crc32(const void *data, size_t length) { const uint8_t *bytes = (const uint8_t *)data; uint32_t crc = UINT32_C(0xFFFFFFFF); if (bytes == NULL && length != 0) { return 0; } while (length != 0) { uint8_t index = (uint8_t)((crc ^ *bytes) & UINT32_C(0xFF)); crc = crc32_table[index] ^ (crc >> 8); ++bytes; --length; } return crc ^ UINT32_C(0xFFFFFFFF); }
